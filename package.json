{
  "name": "dealerlink",
  "version": "1.0.0",
  "description": "DealerLink - B2B wholesale ordering and dealer management",
  "scripts": {
    "dev": "node scripts/ensure-dist.mjs && concurrently -k -n api,web -c blue,green \"wrangler dev --port 8787\" \"vite\"",
    "dev:api": "node scripts/ensure-dist.mjs && wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply dealerlink --local",
    "db:migrate:remote": "wrangler d1 migrations apply dealerlink --remote",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset-local.mjs && npm run db:migrate && npm run db:seed",
    "create-admin": "node scripts/create-admin.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  },
  "private": true
}
