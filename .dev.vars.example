# Copy to .dev.vars for local development. Never commit .dev.vars.
# Comma-separated extra origins allowed to call the API (the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
# Lets the seeded demo accounts log in. MUST stay "false"/unset in production.
ALLOW_DEMO_ACCOUNTS=true
# Returns password-reset links in the forgot-password API response (dev only).
DEV_SHOW_RESET_LINKS=true
# Phone alerts (Web Push). Create real values with `npm run push:keys`; leave unset to switch alerts off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:). Defaults to the site's own URL.
# VAPID_SUBJECT=mailto:you@example.com
# Bot check (Cloudflare Turnstile). Leave unset to switch it off. Cloudflare's always-pass test keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
