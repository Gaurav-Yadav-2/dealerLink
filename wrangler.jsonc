{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealerlink",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dealerlink",
      // Replace with the id printed by `wrangler d1 create dealerlink` before deploying.
      "database_id": "267c4a14-1178-4d28-8428-53b78ccb69e8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOW_DEMO_ACCOUNTS": "false",
    "DEV_SHOW_RESET_LINKS": "false",
    "ALLOWED_ORIGINS": "",
    // Public Turnstile site key (bot check). Leave empty to switch the check off. The secret goes in `wrangler secret put TURNSTILE_SECRET_KEY`.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF9xNhQebcN3Hgjf"
  },
  "observability": { "enabled": true }
}
